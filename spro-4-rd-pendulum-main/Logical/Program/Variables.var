VAR
	x : REAL;
	theta : REAL;
	x_old : REAL;
	theta_old : REAL;
	x_dot : REAL;
	controller : system_State := lqi;
	theta_dot : REAL;
	u : REAL;
	u_scale : INT := 2275;
	systemState : system_State := pendulReset;
	Tf : REAL := 0.01;
	Ts : REAL := 0.001;
	x_enc_scale : REAL := 243500.0;
	theta_enc_scale : REAL := 0.001533980788;
	x_enc_middle : REAL := 191000.0;
	theta_enc_middle : REAL := 2048.0;
	count : USINT := 0;
	led_ton : TON;
	resetTimer : TON;
	max_torque : INT := 15000;
	opc_state : REAL;
	opc_step : REAL;
	opc_x : REAL;
	opc_theta : REAL;
	opc_u : REAL;
END_VAR
